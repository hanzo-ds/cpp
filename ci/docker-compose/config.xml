<?xml version="1.0"?>
<!--
  Server-side settings the test suite depends on, layered over the config the
  ghcr.io/hanzoai/datastore image already ships (see ../docker-compose.yml).

  The root element is <clickhouse> ON PURPOSE. It is defined by the SERVER, not
  by this client, and it must match the root of the drop-ins the image ships in
  config.d/ - those are what white-label the data paths, set the wildcard
  listen_host and put the engine's HTTP port behind the nginx proxy. A
  mismatched root does NOT fail loudly: the server logs "Merging bypassed" and
  starts with every drop-in silently discarded.
-->
<clickhouse>

  <!-- Tests read system.query_log right after issuing a query, so flush fast. -->
  <query_log>
    <database>system</database>
    <table>query_log</table>
    <partition_by>toYYYYMM(event_date)</partition_by>
    <flush_interval_milliseconds>1000</flush_interval_milliseconds>
  </query_log>

  <!-- Required by the tracing-context tests. -->
  <opentelemetry_span_log>
    <engine>
      engine MergeTree
      partition by toYYYYMM(finish_date)
      order by (finish_date, finish_time_us, trace_id)
    </engine>
    <database>system</database>
    <table>opentelemetry_span_log</table>
    <flush_interval_milliseconds>7500</flush_interval_milliseconds>
  </opentelemetry_span_log>

</clickhouse>
